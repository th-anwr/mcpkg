# Copy to .env and fill in, or generate one with ./scripts/make-env.sh (recommended).
# Keep comments on their own lines: inline "# ..." after a value is not portable.

# --- Site ---
SITE_NAME=mcpkg
# Public URL. "auto" = http://<server IP> until you have a domain (push.sh fills it in).
SITE_URL=auto
# Caddy gets a TLS certificate for this domain automatically. ":80" = plain HTTP on the IP.
DOMAIN=:80
# Reverse-DNS of your domain; namespaces trust data in the /v0.1/servers API (_meta).
META_NAMESPACE=com.example.mcpkg
# Optional: added to the crawler User-Agent (crates.io asks crawlers for contact info).
CONTACT_EMAIL=
# Enables /admin/review (HTTP basic auth, any username).
ADMIN_PASSWORD=change-me

# --- Database ---
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgres://mcpkg:change-me-too@db:5432/mcpkg?sslmode=disable
# Workers: push.sh rewrites the host to the core box's private IP automatically.
# Core: bootstrap.sh sets DB_BIND to the private IP automatically (security group: mcpkg boxes only).

# --- GitHub (strongly recommended) ---
# Fine-grained token, public repositories read-only, no extra permissions.
# Enables GraphQL batching (25 repos per request, 5,000 points/hour) and the topic-search source.
GITHUB_TOKEN=

# --- LLM for descriptions (optional; README-based fallback text if empty) ---
# Any OpenAI-compatible endpoint, for example:
#   Bedrock (may use AWS credits): LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1   LLM_MODEL=openai.gpt-oss-20b   LLM_API_KEY=<Bedrock API key>
#   DeepInfra:                     LLM_BASE_URL=https://api.deepinfra.com/v1/openai           LLM_MODEL=openai/gpt-oss-20b
#   OpenRouter:                    LLM_BASE_URL=https://openrouter.ai/api/v1                  LLM_MODEL=openai/gpt-oss-20b
#   self-hosted vLLM:              LLM_BASE_URL=http://<private-ip>:8000/v1                   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
#   Ollama (dev, CPU):             LLM_BASE_URL=http://localhost:11434/v1                     LLM_MODEL=qwen3:4b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai.gpt-oss-20b
# Set to false if the endpoint rejects response_format; output is validated either way.
LLM_JSON_MODE=true
# Share of LLM outputs sent to the human review queue.
LLM_REVIEW_SAMPLE=0.01

# --- Smoke-test sandbox ---
# docker (production) | process (local dev ONLY, no isolation) | off
SANDBOX=docker
SANDBOX_IMAGE=mcpkg-runner:latest
# gVisor; leave empty to use the default runc runtime.
SANDBOX_RUNTIME=runsc
SANDBOX_EGRESS_NETWORK=mcpkg-egress
SANDBOX_PROXY=http://egress-proxy:3128
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1

LOG_LEVEL=info
